---
import { getCollection } from "astro:content";
import Container from "../../components/Container.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
  title="Blog"
  description="Notes on computers, networks, and making things more complicated than they need to be."
>
  <Container>
    <div class="space-y-1">
      <h1 class="text-3xl font-semibold text-black dark:text-white">Blog</h1>
      <h3 class="text-xl text-black/60 dark:text-white/80">
        A place for my thoughts in markdown.
      </h3>
      <p class="text-sm text-black/60 dark:text-white/70">
        <a
          class="underline hover:text-black dark:hover:text-white"
          href="/rss.xml">Subscribe via RSS</a
        >
      </p>
    </div>

    <section class="mt-12" aria-label="Posts">
      <ol class="space-y-9 border-l border-black/15 pl-6 dark:border-white/15">
        {
          posts.map((post) => (
            <li class="relative">
              <span
                class="absolute top-1.5 -left-[1.86rem] size-3 rounded-full border-2 border-neutral-100 bg-black dark:border-neutral-900 dark:bg-white"
                aria-hidden="true"
              />
              <a
                href={`/blog/${post.id}`}
                class="group block space-y-2 text-current transition-colors duration-300 ease-in-out hover:text-black dark:hover:text-white"
              >
                <FormattedDate date={post.data.pubDate} />
                <h2 class="text-xl font-semibold text-black transition-transform duration-300 group-hover:translate-x-1 dark:text-white">
                  {post.data.title}
                </h2>
                <p class="max-w-xl text-sm leading-6 text-black/60 dark:text-white/70">
                  {post.data.description}
                </p>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </Container>
</Layout>
