---
import Layout from '../layouts/Layout.astro';

const socials: { name: string; href: string; handle?: string }[] = [
	{ name: 'GitHub', href: 'https://github.com/diogowho' },
  { name: 'Steam', href: 'https://steamcommunity.com/profiles/76561198950840617', handle: 'id/sweetlies' },
	{ name: 'Signal', href: 'https://signal.me/#eu/z2rBJfY8EseFhOyCZ_bT4SqZ_FNCBMT8fG0XjmKpyn0YwFOcwkdOw7qYvIjlzQoh', handle: '@diogo.06' },
	{ name: 'Email', href: 'mailto:website@diogocastro.net' },
];

function handleFor(href: string): string {
	if (href.startsWith('mailto:')) return href.slice(7);
	const { host, pathname } = new URL(href);
	return host + pathname.replace(/\/$/, '');
}

const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Diogo Castro',
	url: Astro.site?.toString().replace(/\/$/, ''),
	email: 'mailto:website@diogocastro.net',
	description: 'Diogo Castro — computer science undergraduate at the Polytechnic University of Setúbal, messing with computers and networks (AS207118).',
	sameAs: socials.filter((s) => s.href.startsWith('http')).map((s) => s.href),
});
---

<Layout title="Diogo Castro">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={personJsonLd} />
	</Fragment>

	<main class="mx-auto max-w-xl px-6 pt-[clamp(3rem,12vh,7rem)] pb-12">
		<header>
			<h1 class="mb-7 font-rounded text-[clamp(2.75rem,9vw,5rem)] font-semibold leading-[1.05] tracking-[-0.02em]">
				Diogo Castro
			</h1>
			<p class="max-w-[34rem] text-[clamp(1.125rem,2.5vw,1.375rem)] leading-[1.65]">
				Computer science undergraduate at the Polytechnic University of Setúbal. I'm usually
				messing with computers, networks @ <a
					class="font-mono text-[0.82em] underline decoration-muted underline-offset-[0.2em] hover:decoration-ink"
          href="https://as207118.net">AS207118</a
				>, learning new things, shitposting or lurking online.
			</p>
		</header>

		<nav aria-label="Social links" class="mt-12 border-t border-line pt-8">
			<ul class="m-0 grid list-none gap-[0.85rem] p-0">
				{socials.map((s) => (
					<li>
						<a
							href={s.href}
							class="group flex items-baseline justify-between gap-4 rounded-[2px] text-ink no-underline focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-ink focus-visible:outline-offset-4"
						>
							<span class="text-lg underline decoration-transparent underline-offset-[0.2em] group-hover:decoration-ink group-focus-visible:decoration-ink">
								{s.name}
							</span>
							<span class="whitespace-nowrap font-mono text-[0.82em] text-muted group-hover:text-ink">
								{s.handle ?? handleFor(s.href)}
							</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</main>
</Layout>
